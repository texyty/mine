<Window x:Class="MyCustomLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NURSULTAN" Height="690" Width="1080" MinHeight="610" MinWidth="900" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#0B1422" FontFamily="Segoe UI">
 <Window.Resources>
  <Storyboard x:Key="Reveal"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/><ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,18,0,0" To="0" Duration="0:0:0.28"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction></ThicknessAnimation></Storyboard>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#152237"/><Setter Property="BorderBrush" Value="#263B55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="54"/><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#0E1828"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#314A67"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Height" Value="54"/><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#0E1828"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#314A67"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#2196F3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#38A6F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#193553"/></Style>
  <Style x:Key="ClientCard" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-5"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="0,6"/><Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="#DCE8F8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="#1C3A5D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#38516E" BorderThickness="1" CornerRadius="8" Margin="8"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="#172941" CornerRadius="7,7,0,0" MouseLeftButtonDown="DragWindow"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NURSULTAN" Foreground="White" FontSize="22" FontWeight="SemiBold"/><Border Margin="20,0,0,0" Padding="12,8" Background="#0C1727" CornerRadius="12"><StackPanel Orientation="Horizontal"><TextBlock Text="🇷🇺" FontSize="17"/><TextBlock Text=" Русский  ▾" Foreground="White" FontWeight="SemiBold" FontSize="15"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="—" FontSize="22" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Click="Minimize_Click"/><Button Content="×" FontSize="29" Foreground="White" Background="Transparent" BorderThickness="0" Width="40" Click="Close_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#102845"/><GradientStop Color="#0B1625" Offset=".58"/><GradientStop Color="#0B1320" Offset="1"/></LinearGradientBrush></Grid.Background>
   <Grid x:Name="LoginPanel"><Grid.Background><RadialGradientBrush Center=".5,.1" GradientOrigin=".5,.1" RadiusX=".9" RadiusY=".9"><GradientStop Color="#153D68" Offset="0"/><GradientStop Color="#0C1727" Offset=".75"/></RadialGradientBrush></Grid.Background><Border Width="390" Padding="40" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".28"/></Border.Effect><StackPanel><TextBlock Text="Авторизация" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Введите свои данные" Foreground="#B8C8DD" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,28"/><TextBox x:Name="UsernameBox" ToolTip="Логин"/><PasswordBox x:Name="PasswordBox" Margin="0,14,0,0" ToolTip="Пароль"/><DockPanel Margin="0,18,0,20"><CheckBox x:Name="RememberBox" Content="Запомнить меня" Foreground="#D7E2F2" FontWeight="SemiBold"/><TextBlock x:Name="LoginHint" Text="" Foreground="#86BFFF" DockPanel.Dock="Right"/></DockPanel><Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="ВОЙТИ" Click="Login_Click"/><Button x:Name="WebLoginButton" Style="{StaticResource SecondaryButton}" Content="↗  ВОЙТИ ЧЕРЕЗ САЙТ" Margin="0,12,0,0" Click="WebLogin_Click"/><TextBlock x:Name="LoginStatus" Foreground="#FF8C98" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></Grid>
   <Grid x:Name="LauncherPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#102039" Margin="16,16,0,16" CornerRadius="14"><DockPanel><StackPanel><Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="⌂" Background="#1C4F80" Click="Home_Click"/><Button x:Name="ProfileNav" Style="{StaticResource NavButton}" Content="♟" Click="Profile_Click"/><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙" Click="Settings_Click"/></StackPanel><Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Content="⇥" Click="Logout_Click" ToolTip="Выйти"/></DockPanel></Border>
    <Grid Grid.Column="1" Margin="26,16,24,16">
     <Grid x:Name="HomePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Клиенты" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Выберите сборку для запуска" Foreground="#A7B8CE" Margin="0,5,0,18"/></StackPanel><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ClientCard}" Click="SelectClient_Click" Tag="MyCustomClient"><Border Width="222" Height="140" CornerRadius="14"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9D212A"/><GradientStop Color="#1B1424" Offset=".9"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Margin="18"><TextBlock Text="Клиент" HorizontalAlignment="Right" Background="#152237" Foreground="White" Padding="7,3"/><TextBlock Text="MYCUSTOM 1.16.5   →" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,32,0,0"/></StackPanel></Border></Button><Button Style="{StaticResource ClientCard}" Click="SelectClient_Click" Tag="MyCustomClient"><Border Width="222" Height="140" CornerRadius="14" Margin="14,0,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D7B83"/><GradientStop Color="#15213A" Offset=".85"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Margin="18"><TextBlock Text="Клиент" HorizontalAlignment="Right" Background="#152237" Foreground="White" Padding="7,3"/><TextBlock Text="ALPHA 1.16.5   →" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,32,0,0"/></StackPanel></Border></Button><Button Style="{StaticResource ClientCard}" Click="SelectClient_Click" Tag="MyCustomClient"><Border Width="222" Height="140" CornerRadius="14" Margin="14,0,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#467D44"/><GradientStop Color="#15213A" Offset=".85"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Bottom" Margin="18"><TextBlock Text="Бесплатно" HorizontalAlignment="Right" Background="#32925A" Foreground="White" Padding="7,3"/><TextBlock Text="LEGACY 1.12.2   →" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,32,0,0"/></StackPanel></Border></Button></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="30" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ГОТОВО К ЗАПУСКУ" Foreground="#45ABF9" FontWeight="Bold"/><TextBlock x:Name="GreetingText" Text="Мой клиент" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,9,0,9"/><StackPanel Orientation="Horizontal"><Ellipse x:Name="ServerDot" Fill="#53DF9E" Width="10" Height="10" Margin="0,3,8,0"/><TextBlock x:Name="ServerStatus" Text="Сервер доступен" Foreground="#B8C9DF"/></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="#9EB2CA" FontSize="11" FontWeight="Bold"/><ComboBox x:Name="RamBox" Margin="0,8,0,16" Height="42" SelectedIndex="2"><ComboBoxItem Content="2 GB" Tag="2"/><ComboBoxItem Content="3 GB" Tag="3"/><ComboBoxItem Content="4 GB" Tag="4"/><ComboBoxItem Content="6 GB" Tag="6"/><ComboBoxItem Content="8 GB" Tag="8"/></ComboBox><Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  ИГРАТЬ" Click="Play_Click"/><Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="ОТМЕНИТЬ ОБНОВЛЕНИЕ" Margin="0,8,0,0" Visibility="Collapsed" Click="Cancel_Click"/><ProgressBar x:Name="Progress" Height="5" Margin="0,18,0,0" Minimum="0" Maximum="100" Foreground="#2196F3" Background="#263C58"/><TextBlock x:Name="LaunchStatus" Foreground="#B8C9DF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Text="Готово к запуску"/></StackPanel></Grid></Border></Grid></Grid>
     <Grid x:Name="ProfilePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Профиль" Foreground="White" FontSize="23" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="Аватар" Foreground="White" FontSize="17" FontWeight="Bold"/><Ellipse Width="92" Height="92" Fill="#2196F3" Margin="0,34,0,14" HorizontalAlignment="Center"/><TextBlock Text="Профиль аккаунта" Foreground="#C7D5E7" HorizontalAlignment="Center"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="30" Margin="18,0,0,0"><StackPanel><TextBlock Text="Данные аккаунта" Foreground="White" FontSize="17" FontWeight="Bold"/><Separator Margin="0,18" Background="#324961"/><TextBlock x:Name="ProfileUsername" Foreground="White" FontSize="16"/><TextBlock x:Name="ProfileAccess" Foreground="#71DFA7" FontSize="16" Margin="0,18,0,0"/><TextBlock x:Name="ProfileHwid" Foreground="#B9C8DA" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></Grid></Grid>
     <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Настройки" Foreground="White" FontSize="23" FontWeight="Bold"/><Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="26" Margin="0,0,10,0"><StackPanel><TextBlock Text="Оперативная память" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="Укажите объём памяти для игры" Foreground="#B6C6DA" Margin="0,18,0,12" TextWrapping="Wrap"/><Slider x:Name="RamSlider" Minimum="2" Maximum="8" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged"/><TextBlock x:Name="RamValueText" Text="4 GB" Foreground="#5FB8FF" FontSize="20" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="26" Margin="10,0,0,0"><StackPanel><TextBlock Text="Расположение" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="Папка с файлами клиентов" Foreground="#B6C6DA" Margin="0,18,0,8"/><TextBox x:Name="GamePathBox" IsReadOnly="True"/><Button Style="{StaticResource SecondaryButton}" Content="ОТКРЫТЬ ПАПКУ" Margin="0,14,0,0" Click="OpenGameFolder_Click"/></StackPanel></Border></Grid></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>
